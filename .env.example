# 大模型调用配置 (默认阿里云百炼/通义千问，可兼容 OpenAI 接口规范)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-plus
LLM_TEMPERATURE=0.1

# 向量模型配置
# Key 留空时：只有当向量模型与对话模型是同一服务商（BASE_URL 域名相同）才复用 LLM_API_KEY，否则使用离线哈希向量
# 例如对话用 DeepSeek、向量用阿里云百炼时，这里必须单独填百炼的 Key
EMBEDDING_API_KEY=your_api_key_here
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v4

# 交叉重排模型配置 (Cross-Encoder)，Key 的复用规则同上
RERANKER_API_KEY=your_api_key_here
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_MODEL_NAME=gte-rerank-v2

# 向量库配置 (可选: qdrant / memory；qdrant 连不上时自动降级为嵌入式内存模式)
# 如果系统开了代理，访问本机 Qdrant 可能被代理拦截（日志里出现 502），请设置 NO_PROXY=localhost,127.0.0.1
VECTOR_DB_TYPE=qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=enterprise_kb

# Embedding 分批（百炼 text-embedding-v4 每次请求最多 10 条）
EMBEDDING_BATCH_SIZE=10
EMBEDDING_MAX_CONCURRENCY=4
# 在线向量写入本地缓存 data/embedding_cache.sqlite，重启重建索引时不再重复调用接口
EMBEDDING_CACHE_ENABLED=true

# 重排相关度阈值（尚未标定，见 缺陷追踪.md API-4）
RERANKER_MIN_SCORE=0.15

# ---------------- Agent 流程开关 ----------------
# 知识库无答案时是否查询外部百科（会把用户问题发给第三方，默认关闭）
WEB_FALLBACK_ENABLED=false
# 多查询扩展 / HyDE（每次问答多 1~2 次 LLM 调用，默认关闭，是否开启以评测结果为准）
ENABLE_MULTI_QUERY=false
ENABLE_HYDE=false
# 幻觉审计不通过时最多重新生成几次（与检索改写次数分开计算）
GENERATION_MAX_RETRIES=1

# ---------------- 安全与限额 ----------------
# 管理令牌：设置后，修改配置/删除文档/触发评测/连通性测试 必须带请求头 X-Admin-Token
# 不设置时，这些管理接口只接受本机且来源在 CORS_ORIGINS 内的请求
ADMIN_TOKEN=
# 允许跨域访问的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=20
MAX_QUERY_CHARS=2000
MAX_HISTORY_MESSAGES=20
MAX_HISTORY_CHARS=8000
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=10
REQUEST_TOTAL_TIMEOUT=120

# 服务监听地址：默认只监听本机；需要局域网访问时改为 0.0.0.0，并务必设置 ADMIN_TOKEN
HOST=127.0.0.1
PORT=8000
# 开发调试（开启热重载与 DEBUG 日志）
DEBUG=false
